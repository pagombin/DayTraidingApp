# =============================================================================
# Trading Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file — it contains secrets.
# =============================================================================

# --- Database ---
DB_USER=trading
DB_PASSWORD=changeme_in_production
DB_NAME=trading_platform
DB_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API Gateway ---
GATEWAY_PORT=8080
WS_PORT=8081
JWT_SECRET=generate_a_real_secret_here
LOG_LEVEL=info

# --- Frontend ---
FRONTEND_PORT=3000

# --- Notifications (optional) ---
ALERT_EMAIL=
ALERT_SMS_TO=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
